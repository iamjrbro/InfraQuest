# Copie este arquivo para .env. Nunca envie .env para repositorios ou chats.
PORT=4180
# Para outros dispositivos, configure HOST e APP_ORIGIN conforme LEIA-ME.txt.
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4180
REWARDS_MODE=approval

# AWS IAM Identity Center - SAML 2.0.
# Requer URL HTTPS publicada, metadados do aplicativo e certificado publico IdP.
# Instale o adaptador opcional com: npm install --ignore-scripts
# AWS_SAML_ENTRY_POINT=https://SEU-ENDPOINT-SSO
# AWS_SAML_IDP_ISSUER=https://SEU-EMISSOR-SAML
# AWS_SAML_CERT_FILE=config/identity-center-public.pem

# Microsoft Entra ID - tenant especifico, OIDC authorization code + PKCE.
# MICROSOFT_ISSUER=https://login.microsoftonline.com/SEU-TENANT-ID/v2.0
# MICROSOFT_CLIENT_ID=SEU-APPLICATION-CLIENT-ID
# MICROSOFT_CLIENT_SECRET=CONFIGURAR-LOCALMENTE-SE-O-APP-FOR-CONFIDENCIAL

# Alternativa opcional: AWS Cognito federado com seu provedor SAML.
# AWS_ISSUER=https://cognito-idp.REGIAO.amazonaws.com/SEU-USER-POOL-ID
# AWS_CLIENT_ID=SEU-APP-CLIENT-ID
# AWS_CLIENT_SECRET=CONFIGURAR-LOCALMENTE-SE-NECESSARIO
